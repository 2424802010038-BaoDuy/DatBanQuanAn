@using System.Collections.Generic
@using DatBanQuanAn.Controllers
@using DatBanQuanAn.Helpers
@{
    ViewBag.Title = "Đổi bàn";
    var d = (DonDatBanView)ViewBag.D; var opts = (List<TableOption>)ViewBag.Options;
}
<h2>Đổi bàn / khu vực</h2>
<p>Đơn <b>@d.MaDon</b> – hiện tại bàn <b>@d.Ban</b> · @Fmt.Date(d.NgayGio) · @d.SoNguoi người</p>
@if (opts.Count == 0)
{
    <div class="alert alert-warning">Hiện không còn bàn trống cùng loại ở khung giờ này.</div>
}
else
{
    using (Html.BeginForm("ChangeTable", "Booking", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@d.Id" />
        <input type="hidden" name="sdt" value="@ViewBag.Sdt" />
        <input type="hidden" name="ma" value="@ViewBag.Ma" />
        <div class="form-group" style="max-width:420px">
            <label>Chọn bàn mới</label>
            <select name="newBanId" class="form-control" required>
                @foreach (var o in opts)
                {
                    <option value="@o.Id">@o.KhuVuc – @o.Ten (@o.SucChua chỗ)</option>
}
            </select>
        </div>
        <button class="btn btn-danger">Xác nhận đổi bàn</button>
    }
}
<a class="btn btn-default" style="margin-top:8px" href="@Url.Action("Lookup", new { sdt = ViewBag.Sdt, ma = ViewBag.Ma })">Quay lại</a>