@{ ViewBag.Title = "Đăng ký"; }
<div class="row"><div class="col-md-5 col-md-offset-3">
<h2>Đăng ký thành viên</h2>
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
@using (Html.BeginForm("Register", "Account", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <div class="form-group"><label>Họ tên</label><input name="hoTen" class="form-control" value="@ViewBag.HoTen" /></div>
    <div class="form-group"><label>SĐT</label><input name="sdt" class="form-control" value="@ViewBag.Sdt" /></div>
    <div class="form-group"><label>Email</label><input name="email" class="form-control" value="@ViewBag.Email" /></div>
    <div class="form-group"><label>Mật khẩu (từ 8 ký tự)</label><input type="password" name="matKhau" class="form-control" /></div>
    <div class="form-group"><label>Xác nhận mật khẩu</label><input type="password" name="xacNhan" class="form-control" /></div>
    <button class="btn btn-danger">Đăng ký</button>
}
</div></div>
