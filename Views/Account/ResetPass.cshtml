@{ ViewBag.Title = "Đặt lại mật khẩu"; }
<h2>Đặt lại mật khẩu</h2>
@using (Html.BeginForm("ResetPass", "Account", FormMethod.Post, new { style = "max-width:380px" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="t" value="@ViewBag.T" />
    <div class="mb-3">
        <label>Mật khẩu mới (từ 8 ký tự)</label>
        <input name="matKhauMoi" type="password" class="form-control" required minlength="8" />
    </div>
    <div class="mb-3">
        <label>Nhập lại mật khẩu mới</label>
        <input name="nhapLai" type="password" class="form-control" required />
    </div>
    <button class="btn btn-danger">Đặt lại mật khẩu</button>
}