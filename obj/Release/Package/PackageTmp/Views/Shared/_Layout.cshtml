@{ var role = Session["Role"] as string; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Đặt bàn quán ăn</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/dbqa.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-inverse fixed-top">
        <div class="container">
            @Html.ActionLink("🍜 Quán Ăn", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    @if (role == null || role == "KhachThanhVien")
                    {
                        <li class="nav-item">@Html.ActionLink("Đặt bàn", "Index", "Booking", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Đơn của tôi", "Lookup", "Booking", null, new { @class = "nav-link" })</li>
                    }
                    @if (role == "PhucVu" || role == "QuanLy")
                    {
                        <li class="nav-item">@Html.ActionLink("Sơ đồ bàn", "Tables", "Staff", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Đơn đặt bàn", "Bookings", "Staff", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Đơn gọi món", "Orders", "Staff", null, new { @class = "nav-link" })</li>
                    }
                    @if (role == "Bep" || role == "QuanLy")
                    {
                        <li class="nav-item">@Html.ActionLink("Bếp/Bar", "Index", "Kitchen", null, new { @class = "nav-link" })</li>
                    }
                    @if (role == "QuanLy")
                    {
                        <li class="nav-item">@Html.ActionLink("Quản trị", "Index", "Admin", null, new { @class = "nav-link" })</li>
                    }
                </ul>
                <ul class="navbar-nav ms-auto">
                    @if (role == null)
                    {
                        <li class="nav-item">@Html.ActionLink("Đăng ký", "Register", "Account", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Đăng nhập", "Login", "Account", null, new { @class = "nav-link" })</li>
                    }
                    else
                    {
                        <li class="nav-item">@Html.ActionLink("👤 " + (Session["Name"] as string), "Profile", "Account", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">
                            @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm", style = "display:inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <a class="nav-link" href="javascript:document.getElementById('logoutForm').submit()">Đăng xuất</a>
                            }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @if (TempData["Ok"] != null)
        {<div class="alert alert-success">@TempData["Ok"]</div>}
        @if (TempData["Err"] != null)
        {<div class="alert alert-danger">@TempData["Err"]</div>}
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>