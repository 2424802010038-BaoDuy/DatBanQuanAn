@{ ViewBag.Title = "Tài khoản"; var u = (DatBanQuanAn.Models.TaiKhoan)ViewBag.U; }
<h2>Thông tin tài khoản</h2>
<div class="row">
    <div class="col-md-5">
        @using (Html.BeginForm("Profile", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-group"><label>SĐT</label><input class="form-control" value="@u.SDT" disabled /></div>
            <div class="form-group"><label>Họ tên</label><input name="hoTen" class="form-control" value="@u.HoTen" /></div>
            <div class="form-group"><label>Email</label><input name="email" class="form-control" value="@u.Email" /></div>
            if (u.VaiTro == "KhachThanhVien")
            {
                <p>Điểm tích lũy: <b>@u.DiemTichLuy</b> · Số lần no-show: @u.SoLanNoShow</p>
            }
            <button class="btn btn-danger">Lưu</button>
        }
    </div>
    <div class="col-md-5 col-md-offset-1">
        <h4>Đổi mật khẩu</h4>
        @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="form-group"><label>Mật khẩu cũ</label><input type="password" name="cu" class="form-control" /></div>
            <div class="form-group"><label>Mật khẩu mới</label><input type="password" name="moi" class="form-control" /></div>
            <div class="form-group"><label>Xác nhận</label><input type="password" name="xacNhan" class="form-control" /></div>
            <button class="btn btn-default">Đổi mật khẩu</button>
        }
    </div>
</div>
