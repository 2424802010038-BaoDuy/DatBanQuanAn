@{ ViewBag.Title = "Đổi mật khẩu"; }
<h2>Đổi mật khẩu</h2>
@if (ViewBag.Error != null)
{<div class="alert alert-danger">@ViewBag.Error</div>}
<div style="max-width:420px">
    @using (Html.BeginForm("ChangePass", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label>SĐT / Email / Tên đăng nhập</label>
            <input name="user" class="form-control" required value="@ViewBag.User" />
        </div>
        <div class="form-group">
            <label>Mật khẩu cũ</label>
            <input name="cu" type="password" class="form-control" required />
        </div>
        <div class="form-group">
            <label>Mật khẩu mới (từ 8 ký tự)</label>
            <input name="moi" type="password" class="form-control" required minlength="8" />
        </div>
        <div class="form-group">
            <label>Nhập lại mật khẩu mới</label>
            <input name="xacNhan" type="password" class="form-control" required minlength="8" />
        </div>
        <button class="btn btn-danger">Đổi mật khẩu</button>
        <a class="btn btn-default" href="@Url.Action("Login")">Quay lại đăng nhập</a>
    }
</div>